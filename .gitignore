node_modules/
dist/
.local/
founder-outputs/

# Env files — keep only committed *.example templates
.env
.env.*
!.env.example
!apps/web/.env.example

# Credentials / keys that must never be committed
*.pem
*.p12
*.pfx
*credentials*.json
*serviceAccount*.json
.firebaserc
firebase.json

data/raw/
*.log
*.tsbuildinfo
coverage/

# Local git worktrees and SDD scratch
.worktrees/
.superpowers/

.firebase/

# Rendered from server.template.json by scripts/publish-registry.sh; carries the real host.
/server.json

# Generated at deploy time from apps/web/public (Hosting serves these before Cloud Run rewrites).
apps/web/firebase-hosting/*
!apps/web/firebase-hosting/.gitkeep

# Local editor settings (personal, not shared)
.vscode/

# Finder droppings. These land in apps/web/public, which ships to Hosting verbatim.
.DS_Store
