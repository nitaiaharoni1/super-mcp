{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nitaiaharoni1/super-mcp",
  "title": "SuperMCP",
  "description": "Israeli online supermarket pricing: the cheapest delivered basket for a shopping list and address.",
  "version": "0.1.0",
  "websiteUrl": "${SUPER_MCP_PUBLIC_SITE_URL}",
  "icons": [
    {
      "src": "${SUPER_MCP_PUBLIC_SITE_URL}/icon-192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    },
    {
      "src": "${SUPER_MCP_PUBLIC_SITE_URL}/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "repository": {
    "url": "https://github.com/nitaiaharoni1/super-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "${SUPER_MCP_PUBLIC_MCP_URL}"
    }
  ]
}
