NEXT_PUBLIC_MCP_URL=http://localhost:8787/mcp
# Whether the published install links carry an Authorization header. Unset means
# keyless, matching an API run with SUPER_MCP_ALLOW_ANONYMOUS=1. Set to 1 if the
# API still demands a key, or every install button hands out a config that 401s.
# NEXT_PUBLIC_MCP_REQUIRES_KEY=1
# Public origin of the marketing site. Used as metadataBase so og:image resolves
# absolutely; without it, link previews can fail to load the social card.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PostHog (Baliprop + Reflex, EU). Leave unset to disable analytics locally.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# The access form POSTs to the API derived from NEXT_PUBLIC_MCP_URL.
# On the API, set CORS_ORIGINS=http://localhost:3000 (or your marketing origin).
